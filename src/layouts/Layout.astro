---
import AppWrapper from '../components/AppWrapper'
import Footer from '../components/Footer.astro'
import '../styles/globals.css'

interface Props {
  title: string
  description?: string
  image?: string
}

const { title, description = 'OPG Mario Leventić - Ekološka proizvodnja žitarica i ratarskih kultura', image } = Astro.props

// Konstruiraj puni URL za trenutnu stranicu
const siteUrl = 'https://eko-leventic.hr'
const currentUrl = new URL(Astro.url.pathname, siteUrl).href
const ogImage = image 
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/Eco_Leventic_Logo.png`
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Eco_Leventic_Logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph / Facebook / Instagram / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} - Eko Leventić`} />
    <meta property="og:site_name" content="Eko Leventić" />
    <meta property="og:locale" content="hr_HR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <AppWrapper client:only="react">
      <slot />
    </AppWrapper>
    <Footer />
  </body>
</html>

