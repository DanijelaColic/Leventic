---
const currentYear = new Date().getFullYear()
---

<footer class="bg-primary-900 text-white mt-16">
  <div class="container mx-auto px-4 py-12">
    <!-- Main Footer Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      
      <!-- Logo & About -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/Eco_Leventic_Logo.png" 
            alt="Eko Leventić Logo" 
            class="w-16 h-16 object-contain bg-white rounded-lg p-1"
          />
          <div>
            <h3 class="text-xl font-bold">Eko Leventić</h3>
            <p class="text-primary-300 text-sm">Zlatna zrna slavonskih polja</p>
          </div>
        </div>
        <p class="text-primary-200 text-sm">
          Ekološka proizvodnja žitarica i ratarskih kultura od 2011. godine.
          Ponosni nositelji oznake "Brašno Hrvatskih polja".
        </p>
      </div>

      <!-- Kontakt -->
      <div>
        <h3 class="text-lg font-bold mb-4 text-primary-100">Kontakt</h3>
        <div class="space-y-2 text-sm text-primary-200">
          <p class="font-semibold text-white">OPG Mario Leventić</p>
          <p>Osječka 120, Čepin</p>
          <p>
            <a href="mailto:info@eko-leventic.hr" class="hover:text-white transition-colors">
              info@eko-leventic.hr
            </a>
          </p>
          <p>
            <a href="tel:+385917369919" class="hover:text-white transition-colors">
              +385 91 736 9919
            </a>
          </p>
          <div class="pt-2 border-t border-primary-800 mt-3">
            <p class="text-xs text-primary-300">IBAN:</p>
            <p class="font-mono text-xs">HR6225000093120447816</p>
          </div>
        </div>
      </div>

      <!-- Pratite nas -->
      <div>
        <h3 class="text-lg font-bold mb-4 text-primary-100">Pratite nas</h3>
        <div class="flex gap-4">
          <a
            href="https://www.facebook.com/ekoleventic"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-primary-800 rounded-lg flex items-center justify-center text-primary-200 hover:bg-primary-700 hover:text-white transition-all"
            aria-label="Facebook"
