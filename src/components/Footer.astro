              Uvjeti korištenja
            </a>
          </li>
          <li>
            <a href="/dostava" class="text-primary-200 hover:text-white transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
              </svg>
              Dostava
            </a>
          </li>
          <li>
            <a href="/povrati" class="text-primary-200 hover:text-white transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"/>
              </svg>
              Povrati i reklamacije
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: lijevo copyright + ENKR, desno OPG info -->
    <div class="border-t border-primary-800 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-primary-300 text-sm text-center md:text-left">
        &copy; {currentYear} Eko Leventić. Sva prava pridržana. | Stranicu izradio:
        <a
          href="https://www.enkr.hr/"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 underline hover:text-white transition-colors"
        >
          ENKR
        </a>
      </p>
      <p class="text-primary-400 text-xs text-center md:text-right">
        OPG Mario Leventić | OIB: 13795127258 | Čepin, Hrvatska
      </p>
