---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Uvjeti korištenja - Eko Leventić">
  <div class="bg-gray-50 min-h-screen py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl font-bold text-primary-900 mb-8">Uvjeti korištenja</h1>
        
        <div class="prose prose-primary max-w-none">
          <h2 class="text-xl font-semibold text-primary-800 mt-6 mb-3">1. Općenito</h2>
          <p class="text-gray-700 mb-4">
            Ovi Uvjeti korištenja uređuju korištenje web stranice i uvjete kupnje proizvoda. 
            Prodavatelj je:
          </p>
          <div class="bg-primary-50 p-4 rounded-lg mb-4">
            <p class="font-semibold text-primary-900">OPG Mario Leventić</p>
            <p class="text-gray-700">Osječka 120, Čepin</p>
            <p class="text-gray-700">
              <a href="mailto:info@eko-leventic.hr" class="text-primary-600 hover:underline">info@eko-leventic.hr</a>
            </p>
            <p class="text-gray-700">+385 91 736 9919</p>
            <p class="text-gray-700 mt-2">
              <span class="text-sm text-gray-500">IBAN:</span><br/>
              HR6225000093120447816
            </p>
          </div>

          <h2 class="text-xl font-semibold text-primary-800 mt-6 mb-3">2. Proizvodi i cijene</h2>
          <p class="text-gray-700 mb-4">
            Sve cijene su izražene u eurima (EUR) i uključuju PDV. 
            Prodavatelj zadržava pravo promjene cijena bez prethodne najave.
          </p>

          <h2 class="text-xl font-semibold text-primary-800 mt-6 mb-3">3. Narudžba</h2>
          <p class="text-gray-700 mb-4">
            Kupoprodajni ugovor između korisnika i prodavatelja smatra se sklopljenim u trenutku 
            kada korisnik završi narudžbu i primi potvrdu narudžbe na e-mail.
          </p>

          <h2 class="text-xl font-semibold text-primary-800 mt-6 mb-3">4. Plaćanje</h2>
          <p class="text-gray-700 mb-2">Dostupni način plaćanja:</p>
          <ul class="list-disc list-inside text-gray-700 mb-4 space-y-1">
            <li>Transakcijski račun</li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t flex gap-4">
          <a href="/" class="text-primary-600 hover:text-primary-700 font-medium">
            ← Povratak na početnu
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
